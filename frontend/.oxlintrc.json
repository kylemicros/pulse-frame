{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "jsx-a11y",
    "import",
    "unicorn",
    "oxc",
    "promise"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "warn",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ],
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "promise/prefer-await-to-then": "error",
    "promise/prefer-catch": "error",
    "promise/no-return-wrap": "error",
    "react/no-deriving-state-in-effects": "error",
    "unicorn/prefer-global-this": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-array-flat": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-includes": "error",
    "unicorn/prefer-object-from-entries": "error",
    "unicorn/prefer-modern-dom-apis": "error",
    "unicorn/prefer-math-min-max": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-native-coercion-functions": "error",
    "unicorn/prefer-modern-math-apis": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/prefer-math-trunc": "error",
    "unicorn/prefer-string-slice": "error",
    "unicorn/prefer-negative-index": "error",
    "unicorn/prefer-array-index-of": "error",
    "unicorn/prefer-regexp-test": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-string-trim-start-end": "error",
    "unicorn/prefer-blob-reading-methods": "error",
    "unicorn/prefer-dom-node-append": "error",
    "unicorn/prefer-dom-node-remove": "error",
    "unicorn/prefer-code-point": "error",
    "unicorn/prefer-keyboard-event-key": "error",
    "unicorn/no-instanceof-array": "error",
    "unicorn/no-useless-promise-resolve-reject": "error"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "playwright-report",
    "test-results"
  ],
  "overrides": [
    {
      "files": [
        "src/**"
      ],
      "rules": {
        "import/no-cycle": [
          "error",
          {
            "ignoreTypes": false
          }
        ],
        "import/no-relative-parent-imports": "error",
        "unicorn/filename-case": [
          "error",
          {
            "case": "kebabCase"
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\.?(/|$)",
                "message": "Use the @/ alias inside src, never a relative path."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/lib/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\.?(/|$)",
                "message": "Use the @/ alias inside src, never a relative path."
              },
              {
                "group": [
                  "@/components",
                  "@/components/**",
                  "@/features",
                  "@/features/**"
                ],
                "message": "lib is the bottom layer and imports neither components nor features. Move the shared code into lib, or pass it in from the caller."
              },
              {
                "group": [
                  "@/app",
                  "@/app.*",
                  "@/main",
                  "@/main.*"
                ],
                "message": "The app and the entry are the top layer, so nothing below them imports @/app or @/main. Move the shared code into @/lib or @/components and import it from there."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/components/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\.?(/|$)",
                "message": "Use the @/ alias inside src, never a relative path."
              },
              {
                "group": [
                  "@/features",
                  "@/features/**"
                ],
                "message": "Shared components do not import features; pass data in as props."
              },
              {
                "group": [
                  "@/app",
                  "@/app.*",
                  "@/main",
                  "@/main.*"
                ],
                "message": "The app and the entry are the top layer, so nothing below them imports @/app or @/main. Move the shared code into @/lib or @/components and import it from there."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\.?(/|$)",
                "message": "Use the @/ alias inside src, never a relative path."
              },
              {
                "group": [
                  "@/features/*/**"
                ],
                "message": "This feature has no import rules yet, so deep @/features imports are blocked. Add an override for its folder to frontend/.oxlintrc.json, copying the capture or monitor block."
              },
              {
                "group": [
                  "@/app",
                  "@/app.*",
                  "@/main",
                  "@/main.*"
                ],
                "message": "The app and the entry are the top layer, so nothing below them imports @/app or @/main. Move the shared code into @/lib or @/components and import it from there."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/capture/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\.?(/|$)",
                "message": "Use the @/ alias inside src, never a relative path."
              },
              {
                "group": [
                  "@/features/**",
                  "!@/features/capture/**"
                ],
                "message": "capture is a leaf feature and imports no other feature. Move the shared code into @/lib or @/components."
              },
              {
                "group": [
                  "@/app",
                  "@/app.*",
                  "@/main",
                  "@/main.*"
                ],
                "message": "The app and the entry are the top layer, so nothing below them imports @/app or @/main. Move the shared code into @/lib or @/components and import it from there."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/monitor/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\.?(/|$)",
                "message": "Use the @/ alias inside src, never a relative path."
              },
              {
                "group": [
                  "@/features/*/**",
                  "!@/features/monitor/**"
                ],
                "message": "Reach another feature only through its index, e.g. @/features/capture."
              },
              {
                "group": [
                  "@/app",
                  "@/app.*",
                  "@/main",
                  "@/main.*"
                ],
                "message": "The app and the entry are the top layer, so nothing below them imports @/app or @/main. Move the shared code into @/lib or @/components and import it from there."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/app.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\.?(/|$)",
                "message": "Use the @/ alias inside src, never a relative path."
              },
              {
                "group": [
                  "@/features/*/**"
                ],
                "message": "The app reaches a feature only through its index, e.g. @/features/monitor."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/main.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\.?(/|$)",
                "message": "Use the @/ alias inside src, never a relative path."
              },
              {
                "group": [
                  "@/features",
                  "@/features/**"
                ],
                "message": "The entry imports no feature; it mounts @/app, which reaches the features."
              }
            ]
          }
        ]
      }
    }
  ]
}
